{
  "expo": {
    "name": "صلاتك",
    "slug": "salatiq-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "salatiq",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج إلى الكاميرا لعرض معاينة مراقبة الصلاة.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-asset",
        { "assets": ["./assets/audio/subhan_allah.mp3"] }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#FDFAEC",
            "image": "./assets/startup/mark.png",
            "imageWidth": 184,
            "resizeMode": "contain",
            "dark": {
              "backgroundColor": "#FDFAEC",
              "image": "./assets/startup/mark.png"
            }
          }
        }
      ],
      "./plugins/withLocalClassification",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kosaai.salatiq",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/salatiq-logo-dark.png"
    }
  }
}
